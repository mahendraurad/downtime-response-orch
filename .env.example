# Safe deployment template. Copy to an ignored .env/.env.local for local use,
# or create identically named Azure App Service settings / Key Vault references.
# Never commit a populated .env or replace these blank secret placeholders.

# Azure AI Foundry / Azure OpenAI advisory endpoint
AZURE_AI_ENDPOINT=https://proj-boxai-dro-resource.services.ai.azure.com
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT=gpt-5.4-mini

# Legacy Azure OpenAI alternative
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional LangSmith observability. Traces include agent inputs and outputs, so
# enable this only in an approved project and avoid sending sensitive payloads.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DRO

# Optional Langfuse observability (dual tracing with LangSmith).
LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development

# Only required by integrations that use the public OpenAI API directly.
OPENAI_API_KEY=

# Azure AI Search RAG retrieval for the DRO SOP index.
AZURE_SEARCH_ENDPOINT=https://ai-search-dro.search.windows.net
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=ai-search-dro
RAG_BACKEND=azure
# auto uses a key when present and otherwise DefaultAzureCredential.
# Use rbac explicitly for managed identity / Azure CLI authentication.
AZURE_SEARCH_AUTH=rbac
AZURE_SEARCH_CONTENT_FIELD=chunk
AZURE_SEARCH_SOURCE_FIELD=title
AZURE_SEARCH_CHUNK_ID_FIELD=chunk_id
AZURE_SEARCH_SOURCE_URI_FIELD=parent_id
AZURE_SEARCH_FAULT_MODE_FIELD=none
AZURE_SEARCH_ASSET_TYPE_FIELD=none
AZURE_SEARCH_ISO_STAGE_FIELD=none
# The current chunk index uses a 3072-dimension text_vector field.
AZURE_SEARCH_VECTOR_FIELD=text_vector

# Optional Azure Identity values. Leave all blank for system-assigned managed
# identity. Set AZURE_CLIENT_ID only for a user-assigned managed identity. For
# local/service-principal RBAC, set client ID, tenant ID, and client secret.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=

# Required only by ingestion/indexer tooling, not by runtime RAG retrieval.
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=sop-dro

# Durable HITL and optional LangGraph checkpoint storage.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
POSTGRES_URL=
HITL_REPOSITORY=auto
CHECKPOINT_BACKEND=none
# Run once for a new database, then set false.
POSTGRES_HITL_SETUP=false
# Run once for a new database, then set false.
POSTGRES_CHECKPOINT_SETUP=false
# LangGraph PostgreSQL checkpointer pool sizing.
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# JWT authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DRO_JWT_SECRET=
DRO_JWT_EXPIRE_HOURS=8

# Local runtime
LOG_LEVEL=INFO
DATA_DIR=./data
