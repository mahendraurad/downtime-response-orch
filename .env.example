# Copy to .env only when optional cloud integrations are being tested.
# Deterministic local agents, the API, and the frontend demo require no secrets.
# Never commit .env.

# Azure AI Foundry / Azure OpenAI advisory endpoint
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT=

# Legacy Azure OpenAI alternative
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Optional LangSmith observability. Traces include agent inputs and outputs, so
# enable this only in an approved project and avoid sending sensitive payloads.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=DRO

# Only required by integrations that use the public OpenAI API directly.
OPENAI_API_KEY=

# Future production knowledge adapters
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=dro-knowledge
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=dro-docs

# Durable HITL store; POSTGRES_URL will also support future workflow checkpoints
POSTGRES_URL=
HITL_REPOSITORY=auto

# JWT authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
DRO_JWT_SECRET=
DRO_JWT_EXPIRE_HOURS=8

# Local runtime
LOG_LEVEL=INFO
DATA_DIR=./data
