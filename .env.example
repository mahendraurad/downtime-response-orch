# Copy to .env only when optional cloud integrations are being tested.
# Deterministic local agents, the API, and the frontend demo require no secrets.
# Never commit .env.

# Azure AI Foundry / Azure OpenAI advisory endpoint
AZURE_AI_ENDPOINT=
AZURE_AI_KEY=
AZURE_AI_DEPLOYMENT=

# Legacy Azure OpenAI alternative
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Future production knowledge adapters
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX_NAME=dro-knowledge
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=dro-docs

# Future durable orchestration/checkpoint store
POSTGRES_URL=

# Local runtime
LOG_LEVEL=INFO
DATA_DIR=./data
