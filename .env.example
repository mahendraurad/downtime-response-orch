# Copy this file to .env and fill in values
# Never commit .env to version control

# Azure AI Foundry — preferred backend for LLM fallback (Phase 5+)
# Endpoint format: https://{resource}.services.ai.azure.com/api/projects/{project}
# SDK: azure-ai-inference (pip install azure-ai-inference)
AZURE_AI_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_KEY=your-foundry-key-here
AZURE_AI_DEPLOYMENT=gpt-4o

# Azure OpenAI — legacy fallback (only needed if NOT using Azure AI Foundry above)
# SDK: openai>=1.0.0 (pip install openai)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Azure AI Search (Phase 6 production vector store)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-key-here
AZURE_SEARCH_INDEX_NAME=dro-knowledge

# PostgreSQL (Phase 8 LangGraph checkpointing)
POSTGRES_URL=postgresql://user:password@localhost:5432/dro_dev

# Azure Blob Storage (Phase 6 document storage)
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;...
AZURE_BLOB_CONTAINER=dro-docs

# Local dev settings
LOG_LEVEL=INFO
DATA_DIR=./data
